<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="Defs_claims-triage" name="Claims triage" namespace="http://insurance-workflow/dmn">
<decision id="claims-triage" name="Claims triage" camunda:historyTimeToLive="P365D"><decisionTable id="dt_claims-triage" hitPolicy="FIRST"><input id="in_claims-triage_0" label="Claim amount"><inputExpression id="ie_claims-triage_0" typeRef="long"><text>claimAmount</text></inputExpression></input><input id="in_claims-triage_1" label="Fraud score"><inputExpression id="ie_claims-triage_1" typeRef="integer"><text>fraudScore</text></inputExpression></input><output id="out_claims-triage_0" label="route" name="route" typeRef="string" /><rule id="r_claims-triage_0"><inputEntry id="ic_claims-triage_0_0"><text></text></inputEntry><inputEntry id="ic_claims-triage_0_1"><text>&gt;=70</text></inputEntry><outputEntry id="oc_claims-triage_0_0"><text>"siu"</text></outputEntry></rule><rule id="r_claims-triage_1"><inputEntry id="ic_claims-triage_1_0"><text>&gt;100000</text></inputEntry><inputEntry id="ic_claims-triage_1_1"><text></text></inputEntry><outputEntry id="oc_claims-triage_1_0"><text>"adjuster"</text></outputEntry></rule><rule id="r_claims-triage_2"><inputEntry id="ic_claims-triage_2_0"><text>&lt;=10000</text></inputEntry><inputEntry id="ic_claims-triage_2_1"><text>&lt;30</text></inputEntry><outputEntry id="oc_claims-triage_2_0"><text>"fast_track"</text></outputEntry></rule><rule id="r_claims-triage_3"><inputEntry id="ic_claims-triage_3_0"><text></text></inputEntry><inputEntry id="ic_claims-triage_3_1"><text></text></inputEntry><outputEntry id="oc_claims-triage_3_0"><text>"adjuster"</text></outputEntry></rule></decisionTable></decision>
</definitions>

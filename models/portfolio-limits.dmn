<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="Defs_portfolio-limits" name="Portfolio limits" namespace="http://insurance-workflow/dmn">
<decision id="portfolio-limits" name="Portfolio limits" camunda:historyTimeToLive="P365D"><decisionTable id="dt_portfolio-limits" hitPolicy="FIRST"><input id="in_portfolio-limits_0" label="VaR % own funds"><inputExpression id="ie_portfolio-limits_0" typeRef="double"><text>var995PctOwnFunds</text></inputExpression></input><input id="in_portfolio-limits_1" label="Max state share %"><inputExpression id="ie_portfolio-limits_1" typeRef="double"><text>maxStateSharePct</text></inputExpression></input><input id="in_portfolio-limits_2" label="Expected loss ratio"><inputExpression id="ie_portfolio-limits_2" typeRef="double"><text>expectedLossRatio</text></inputExpression></input><output id="out_portfolio-limits_0" label="decision" name="decision" typeRef="string" /><rule id="r_portfolio-limits_0"><inputEntry id="ic_portfolio-limits_0_0"><text>&gt;25</text></inputEntry><inputEntry id="ic_portfolio-limits_0_1"><text></text></inputEntry><inputEntry id="ic_portfolio-limits_0_2"><text></text></inputEntry><outputEntry id="oc_portfolio-limits_0_0"><text>"escalate"</text></outputEntry></rule><rule id="r_portfolio-limits_1"><inputEntry id="ic_portfolio-limits_1_0"><text>&gt;15</text></inputEntry><inputEntry id="ic_portfolio-limits_1_1"><text></text></inputEntry><inputEntry id="ic_portfolio-limits_1_2"><text></text></inputEntry><outputEntry id="oc_portfolio-limits_1_0"><text>"review"</text></outputEntry></rule><rule id="r_portfolio-limits_2"><inputEntry id="ic_portfolio-limits_2_0"><text></text></inputEntry><inputEntry id="ic_portfolio-limits_2_1"><text>&gt;30</text></inputEntry><inputEntry id="ic_portfolio-limits_2_2"><text></text></inputEntry><outputEntry id="oc_portfolio-limits_2_0"><text>"review"</text></outputEntry></rule><rule id="r_portfolio-limits_3"><inputEntry id="ic_portfolio-limits_3_0"><text></text></inputEntry><inputEntry id="ic_portfolio-limits_3_1"><text></text></inputEntry><inputEntry id="ic_portfolio-limits_3_2"><text>&gt;0.8</text></inputEntry><outputEntry id="oc_portfolio-limits_3_0"><text>"review"</text></outputEntry></rule><rule id="r_portfolio-limits_4"><inputEntry id="ic_portfolio-limits_4_0"><text></text></inputEntry><inputEntry id="ic_portfolio-limits_4_1"><text></text></inputEntry><inputEntry id="ic_portfolio-limits_4_2"><text></text></inputEntry><outputEntry id="oc_portfolio-limits_4_0"><text>"ok"</text></outputEntry></rule></decisionTable></decision>
</definitions>

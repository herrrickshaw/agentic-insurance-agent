<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="Defs_underwriting" name="Underwriting" namespace="http://insurance-workflow/dmn">
<decision id="underwriting" name="Underwriting" camunda:historyTimeToLive="P365D"><decisionTable id="dt_underwriting" hitPolicy="FIRST"><input id="in_underwriting_0" label="Age"><inputExpression id="ie_underwriting_0" typeRef="integer"><text>age</text></inputExpression></input><input id="in_underwriting_1" label="Sum insured"><inputExpression id="ie_underwriting_1" typeRef="long"><text>sumInsured</text></inputExpression></input><input id="in_underwriting_2" label="Smoker"><inputExpression id="ie_underwriting_2" typeRef="boolean"><text>smoker</text></inputExpression></input><output id="out_underwriting_0" label="decision" name="decision" typeRef="string" /><output id="out_underwriting_1" label="loadingPct" name="loadingPct" typeRef="integer" /><rule id="r_underwriting_0"><inputEntry id="ic_underwriting_0_0"><text>&lt;18,&gt;70</text></inputEntry><inputEntry id="ic_underwriting_0_1"><text></text></inputEntry><inputEntry id="ic_underwriting_0_2"><text></text></inputEntry><outputEntry id="oc_underwriting_0_0"><text>"decline"</text></outputEntry><outputEntry id="oc_underwriting_0_1"><text>0</text></outputEntry></rule><rule id="r_underwriting_1"><inputEntry id="ic_underwriting_1_0"><text></text></inputEntry><inputEntry id="ic_underwriting_1_1"><text>&gt;10000000</text></inputEntry><inputEntry id="ic_underwriting_1_2"><text></text></inputEntry><outputEntry id="oc_underwriting_1_0"><text>"refer"</text></outputEntry><outputEntry id="oc_underwriting_1_1"><text>0</text></outputEntry></rule><rule id="r_underwriting_2"><inputEntry id="ic_underwriting_2_0"><text>&gt;50</text></inputEntry><inputEntry id="ic_underwriting_2_1"><text></text></inputEntry><inputEntry id="ic_underwriting_2_2"><text>true</text></inputEntry><outputEntry id="oc_underwriting_2_0"><text>"refer"</text></outputEntry><outputEntry id="oc_underwriting_2_1"><text>25</text></outputEntry></rule><rule id="r_underwriting_3"><inputEntry id="ic_underwriting_3_0"><text></text></inputEntry><inputEntry id="ic_underwriting_3_1"><text></text></inputEntry><inputEntry id="ic_underwriting_3_2"><text>true</text></inputEntry><outputEntry id="oc_underwriting_3_0"><text>"auto_approve"</text></outputEntry><outputEntry id="oc_underwriting_3_1"><text>25</text></outputEntry></rule><rule id="r_underwriting_4"><inputEntry id="ic_underwriting_4_0"><text>&gt;50</text></inputEntry><inputEntry id="ic_underwriting_4_1"><text></text></inputEntry><inputEntry id="ic_underwriting_4_2"><text>false</text></inputEntry><outputEntry id="oc_underwriting_4_0"><text>"auto_approve"</text></outputEntry><outputEntry id="oc_underwriting_4_1"><text>10</text></outputEntry></rule><rule id="r_underwriting_5"><inputEntry id="ic_underwriting_5_0"><text></text></inputEntry><inputEntry id="ic_underwriting_5_1"><text></text></inputEntry><inputEntry id="ic_underwriting_5_2"><text></text></inputEntry><outputEntry id="oc_underwriting_5_0"><text>"auto_approve"</text></outputEntry><outputEntry id="oc_underwriting_5_1"><text>0</text></outputEntry></rule></decisionTable></decision>
</definitions>
